{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=.;Initial Catalog=CRUDOrdersDb;Integrated Security=True;Trust Server Certificate=True"
  },
  "Jwt": {
    "SecretKey": "your-very-long-secret-key-min-32-characters-for-production-use",
    "Issuer": "CRUDOrders",
    "Audience": "CRUDOrders.Users",
    "ExpiryMinutes": 60
  },
  "Features": {
    "EnableRedisCache": false
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "DefaultExpiryMinutes": 5
  },
  "Pagination": {
    "MaxSkip": 99,
    "MinSkip": 0,
    "MinTake": 1,
    "MaxTake": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
